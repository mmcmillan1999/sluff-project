# Frontend environment (Vite). Copy to .env for local overrides; .env is gitignored.
#
# The app picks its backend by hostname (frontend/src/services/api.js):
#   playsluff.com / *.netlify.app  -> https://sluff-backend.onrender.com
#   localhost                      -> http://localhost:3005
# Set this only to override that detection, e.g. when a phone on the LAN or a
# Capacitor shell should talk to your dev machine:
# VITE_SERVER_URL=http://10.0.0.40:3005

# Backend Environment Variables

# Server Configuration
PORT=3005
NODE_ENV=development

# Frontend URL — used to build verification/password-reset email links AND as a
# CORS origin. MUST point at the live frontend or those email links 404.
# Local development: http://localhost:3000
# Production: https://playsluff.com   (NOT the old sluff.netlify.app, which is dead)
CLIENT_ORIGIN=http://localhost:3000

# Database
POSTGRES_CONNECT_STRING="your_postgres_connection_string_here"

# Authentication
JWT_SECRET=your_jwt_secret_here

# Email: Resend is the only provider (SENDGRID rail removed Sept 2026).
RESEND_API_KEY=
SENDER_EMAIL_ADDRESS=noreply@yourdomain.com

# LLM providers for the SuperBot/aiService layer (backend/src/services/aiService.js).
# Optional — the live bot brains are heuristic and need no key. Verify changes
# with: node scripts/smoke-test-ai.js
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ElevenLabs text-to-speech for champion name lines and voice-line generation
# scripts (services/championLine.js). Optional; without it champions are silent.
ELEVENLABS_API_KEY=

# Bot insurance pricing. Default is the Monte Carlo market strategy; "legacy"
# reverts to AdaptiveInsuranceStrategy (also the on-error fallback).
# INSURANCE_STRATEGY=market

# Seconds an idle-but-connected human gets before the AFK backstop acts for them.
# AFK_TURN_TIMEOUT_SECONDS=45

# Optional manual/E2E test configuration. The scripts skip without these values.
# Keep these pointed at disposable local/test accounts and databases. Remote targets
# additionally require SLUFF_E2E_ALLOW_REMOTE=true.
# SLUFF_E2E_SERVER_URL=http://localhost:3000
# SLUFF_E2E_USER_EMAIL=test-user@example.com
# SLUFF_E2E_USER_PASSWORD=use-a-disposable-test-password
# SLUFF_E2E_REGISTRATION_EMAIL_DOMAIN=example.com
# SLUFF_E2E_REGISTRATION_PASSWORD=use-a-disposable-registration-password
# SLUFF_E2E_DATABASE_URL=postgresql://user:password@localhost:5432/sluff_test
# SLUFF_E2E_DATABASE_SSL=false
# SLUFF_E2E_ALLOW_REMOTE=false

# Render API key for scripts/rotate-render-secrets.js (Account Settings → API Keys).
# Never needed by the running server; keep it out of Render's own environment.
# RENDER_API_KEY=

# Required when running backup-db.js: keep plaintext database backups outside
# the repository/synced folder, access-restricted, and encrypted at rest.
# SLUFF_BACKUP_DIR=C:\secure\sluff-backups

# Player-requested game voids: allowed this long after a game ends, this many
# per account per season (backend/src/data/gameVoidPolicy.js).
# GAME_VOID_WINDOW_HOURS=24
# GAME_VOID_QUOTA_PER_SEASON=3

# Optional abandoned-game recovery tuning. Defaults are deliberately conservative.
# ABANDONED_GAME_GRACE_HOURS=6
# ABANDONED_GAME_RECOVERY_INTERVAL_MINUTES=15

# Bot exhibition: one continuous 3-bot game (random trio each game) on a
# designated lobby table, feeding round_results analytics. OFF by default
# since Sept 2026 (bot-only games ran 10:1 against human games and inflated
# the season board); set to true to bring it back.
# BOT_EXHIBITION_ENABLED=false
# Comma-separated list (wins); the singular BOT_EXHIBITION_TABLE_ID is still honored.
# BOT_EXHIBITION_TABLE_IDS=table-10,table-20
# BOT_EXHIBITION_INTERVAL_SECONDS=45
